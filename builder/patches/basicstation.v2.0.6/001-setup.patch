Subject: Use the local compiler when building on the target

Upstream maps each platform to one fixed toolchain triplet (corecell and rpi
assume 32-bit ARM with glibc) and uses the local gcc only when it reports that
exact triplet. The image is built on each target platform, so the build passes
arch=<name> and setup.gmk then takes the local gcc's own triplet. That also
covers musl, whose gcc reports *-alpine-linux-musl*.

diff --git a/setup.gmk b/setup.gmk
index d7c4363..148d53b 100644
--- a/setup.gmk
+++ b/setup.gmk
@@ -35,6 +35,7 @@ NQ = $(if ${V},>/dev/null,)
 
 platform ?= linux
 variant  ?= std
+arch     ?= default
 
 -include ${TD}/setup-${platform}.gmk
 
@@ -47,6 +48,12 @@ ARCH.corecell  = arm-linux-gnueabihf
 ARCH.rpi     = arm-linux-gnueabihf
 ARCH.kerlink = arm-klk-linux-gnueabi
 ARCH=${ARCH.${platform}}
+# Building on the target itself, natively or under emulation: the local gcc is
+# the right compiler, whatever triplet its libc gives it (glibc reports
+# *-linux-gnu*, musl *-alpine-linux-musl*), so no cross toolchain is looked for.
+ifneq (default,${arch})
+ARCH := ${LOCAL_ARCH}
+endif
 
 export TDfull := $(shell cd ${TD} && pwd)
 TOOLCHAIN=${HOME}/toolchain-${platform}
