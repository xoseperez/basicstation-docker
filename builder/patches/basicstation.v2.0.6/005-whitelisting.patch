index 2bbb7e5..5e5ef8e 100644
--- a/src-linux/sys_linux.c
+++ b/src-linux/sys_linux.c
@@ -61,7 +61,11 @@ extern void setupConfigFilenames ();
 extern int checkUris ();
 extern void checkRollForward ();
 
-
+#define WHITELIST_SIZE  16
+extern u4_t static_netids[WHITELIST_SIZE];
+extern u1_t static_netids_count;
+extern u4_t static_ouis[WHITELIST_SIZE];
+extern u1_t static_ouis_count;
 
 #if defined(CFG_ral_master_slave)
 static const char* const SLAVE_ENVS[] = {
@@ -792,6 +796,40 @@ static int parseStationConf () {
                     setWebDir(uj_str(&D), filename);
                     break;
                 }
+                case J_whitelist_netids: {
+                    // Every slot is read, so the decoder stays in step, but only
+                    // WHITELIST_SIZE values fit: the rest are dropped and counted.
+                    int entries = 0;
+                    uj_enterArray(&D);
+                    while( uj_nextSlot(&D) >= 0 ) {
+                        str_t value = uj_str(&D);
+                        entries++;
+                        if( static_netids_count < WHITELIST_SIZE )
+                            static_netids[static_netids_count++] = ((int) strtol(value, NULL, 0)) & 0x00FFFFFF;
+                    }
+                    uj_exitArray(&D);
+                    if( entries > static_netids_count )
+                        LOG(MOD_SYS|WARNING, "whitelist_netids: %d entries, kept %d, ignored %d",
+                            entries, static_netids_count, entries - static_netids_count);
+                    break;
+                }
+                case J_whitelist_ouis: {
+                    // Every slot is read, so the decoder stays in step, but only
+                    // WHITELIST_SIZE values fit: the rest are dropped and counted.
+                    int entries = 0;
+                    uj_enterArray(&D);
+                    while( uj_nextSlot(&D) >= 0 ) {
+                        str_t value = uj_str(&D);
+                        entries++;
+                        if( static_ouis_count < WHITELIST_SIZE )
+                            static_ouis[static_ouis_count++] = ((int) strtol(value, NULL, 0)) & 0x00FFFFFF;
+                    }
+                    uj_exitArray(&D);
+                    if( entries > static_ouis_count )
+                        LOG(MOD_SYS|WARNING, "whitelist_ouis: %d entries, kept %d, ignored %d",
+                            entries, static_ouis_count, entries - static_ouis_count);
+                    break;
+                }
                 default: {
                     dbuf_t b = uj_skipValue(&D);
