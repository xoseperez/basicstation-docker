#!/usr/bin/env bash

# -----------------------------------------------------------------------------
# Usage: start [--render [--autoprovision]]
#
#   --render         Resolve the settings and write /app/config exactly as a
#                    normal start does, print the summary, then exit 0 instead
#                    of launching station. A missing radio device is only a
#                    warning. Hardware is probed only when the settings ask for
#                    it (MODEL or DEVICE unset or AUTO, GATEWAY_EUI_SOURCE=chip).
#   --autoprovision  With --render, also register the gateway with The Things
#                    Stack. It is off by default because autoprovisioning
#                    revokes the gateway's previous key, which would disconnect
#                    a gateway that is running with it.
# -----------------------------------------------------------------------------

# shellcheck source-path=SCRIPTDIR
# shellcheck source=common.sh
source "$( dirname "$( readlink -f "$0" )" )/common.sh"

RENDER=0
RENDER_AUTOPROVISION=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --render) RENDER=1 ;;
        --autoprovision) RENDER_AUTOPROVISION=1 ;;
        *)
            echo -e "${COLOR_ERROR}ERROR: Unknown option '$1'. Usage: start [--render [--autoprovision]]${COLOR_END}"
            exit 1
            ;;
    esac
    shift
done
if [[ ${RENDER_AUTOPROVISION} -eq 1 ]] && [[ ${RENDER} -eq 0 ]]; then
    echo -e "${COLOR_ERROR}ERROR: --autoprovision only applies to --render; a normal start always autoprovisions when TTS credentials are set${COLOR_END}"
    exit 1
fi

# Settings a static station.conf replaces, noted before any default is applied
# so the summary can say which ones the user set but are ignored
STATIC_IGNORED=()
for VAR in WHITELIST_NETIDS WHITELIST_OUIS GPS_DEV HAS_GPS; do
    [[ -n "${!VAR}" ]] && STATIC_IGNORED+=( "${VAR}" )
done

# -----------------------------------------------------------------------------
# Utils
# -----------------------------------------------------------------------------

function idle() {

    # Report GATEWAY_EUI if already defined
    [[ -n "${GATEWAY_EUI}" ]] && echo -e "${COLOR_INFO}GATEWAY_EUI: ${GATEWAY_EUI}${COLOR_END}"

    # A render reports the error at once; a normal start waits 5 seconds so a
    # restart policy doesn't spin
    [[ ${RENDER} -eq 1 ]] && exit 1
    sleep 5
    exit 1

}

function create_reset_file {

    local RESET_FILE=/app/config/reset.sh

    resolve_use_libgpiod

    if [[ "${INTERFACE}" == "USB" ]]; then
        echo "" > ${RESET_FILE}
        chmod +x "${RESET_FILE}"
    else
        render_reset_file "${RESET_FILE}" "${RESET_GPIO:-17}" "${POWER_EN_GPIO:-0}" "${POWER_EN_LOGIC:-1}" || idle
    fi
    ln -s "${RESET_FILE}" /app/config/reset_lgw.sh 2>/dev/null

}

function chip_id {

    local DESIGN=$1
    local DEVICE=$2
    local CHIP_ID
    # Per probe: a tty probe sets it, and an SPI probe after it must not inherit it
    local COM_TYPE=""

    [[ "$DEVICE" == *"ttyV"* ]] && TIMEOUT=10 || TIMEOUT=3

    if [[ "$DESIGN" == "auto" ]] || [[ "$DESIGN" == "corecell" ]]; then
        [[ "$DEVICE" == *"tty"* ]] && COM_TYPE="-u"
        CHIP_ID=$( timeout "${TIMEOUT}s" /app/artifacts/corecell/chip_id "$COM_TYPE" -d "$DEVICE" | grep 'EUI' | sed 's/^.*0x//' | tr "[:lower:]" "[:upper:]" )
        if [[ -n ${CHIP_ID} ]]; then
            RESPONSE=( "corecell" "$DEVICE" "$CHIP_ID" )
            return 1
        fi
    fi

    if [[ "$DESIGN" == "auto" ]] || [[ "$DESIGN" == "picocell" ]]; then
        CHIP_ID=$( timeout "${TIMEOUT}s" /app/artifacts/picocell/chip_id -d "$DEVICE" | tr "[:lower:]" "[:upper:]" )
        if [[ -n ${CHIP_ID} ]]; then
            RESPONSE=( "picocell" "$DEVICE" "$CHIP_ID" )
            sleep 5
            return 1
        fi
    fi

    return 0

}

function discover_concentrator {

    local INTERFACE=$1
    local DESIGN=$2
    local RADIO_NUM=$3

    # Grab potential devices based on interface
    if [[ "${INTERFACE}" == "AUTO" ]]; then
        DEVICES=$( ls /dev/spidev* /dev/ttyACM* /dev/ttyUSB* /dev/ttyV* 2> /dev/null )
    elif [[ "${INTERFACE}" == "SPI" ]]; then
        DEVICES=$( ls /dev/spidev* 2> /dev/null )
    else
        DEVICES=$( ls /dev/ttyACM* /dev/ttyUSB* /dev/ttyV* 2> /dev/null )
    fi

    # Look for devices
    FOUND=0
    for DEVICE in $DEVICES; do
        chip_id "${DESIGN,,}" "${DEVICE}"
        if [[ $? -eq 1 ]]; then
            FOUND=$(( FOUND + 1 ))
            if [[ ${FOUND} -eq ${RADIO_NUM} ]]; then
                # We pass the RESPONSE to the caller
                break
            fi
        fi
    done

    return $FOUND

}

# tts_api METHOD PATH [BODY]: calls The Things Stack API on SERVER and prints
# the reply. The personal key goes in a header read from a file descriptor and
# the body on stdin, so neither is on curl's command line, where any process
# listing would show them. The timeouts stop an unreachable server from
# holding up the start.
function tts_api {

    local METHOD=$1
    local URL_PATH=$2

    if [[ $# -ge 3 ]]; then
        curl --silent --show-error --location --connect-timeout 10 --max-time 30 \
            --header @<( printf 'Authorization: Bearer %s\n' "${TTS_PERSONAL_KEY}" ) \
            --header 'Accept: application/json' \
            --header 'Content-Type: application/json' \
            --request "${METHOD}" \
            --data-binary @- \
            "https://${SERVER}${URL_PATH}" <<< "$3"
    else
        curl --silent --show-error --location --connect-timeout 10 --max-time 30 \
            --header @<( printf 'Authorization: Bearer %s\n' "${TTS_PERSONAL_KEY}" ) \
            --header 'Accept: application/json' \
            --request "${METHOD}" \
            "https://${SERVER}${URL_PATH}"
    fi

}

# Registers the gateway (TTS_EUI) and creates a fresh LNS key for it in TC_KEY.
# TC_KEY stays empty when anything fails.
function tts_autoprovision() {

    # Autoprovision variables needed
    GATEWAY_PREFIX=${GATEWAY_PREFIX:-"eui"}
    GATEWAY_ID=${GATEWAY_ID:-"${GATEWAY_PREFIX,,}-${TTS_EUI,,}"}
    GATEWAY_NAME=${GATEWAY_NAME:-${GATEWAY_ID}}

    # Autoprovision regions defined here: https://www.thethingsindustries.com/docs/reference/frequency-plans/
    TTS_FREQUENCY_PLAN_ID=${TTS_FREQUENCY_PLAN_ID:-""}
    if [[ "$TTS_FREQUENCY_PLAN_ID" == "" ]]; then
        if [[ "$TTS_REGION" == "nam1" ]]; then
            TTS_FREQUENCY_PLAN_ID="US_902_928_FSB_2"
        elif [[ "$TTS_REGION" == "au1" ]]; then
            TTS_FREQUENCY_PLAN_ID="AU_915_928_FSB_2"
        else
            TTS_FREQUENCY_PLAN_ID="EU_863_870_TTN"
        fi
    fi

    local API_KEY_NAME="autoprovision-lns-key"
    local BODY RAW CODE MESSAGE IDS ID KEY

    # Register the gateway. The JSON is built by jq, so quotes or backslashes in
    # any value arrive intact instead of breaking the request.
    BODY=$( jq -n \
        --arg id "${GATEWAY_ID}" \
        --arg eui "${TTS_EUI}" \
        --arg name "${GATEWAY_NAME}" \
        --arg server "${SERVER}" \
        --arg plan "${TTS_FREQUENCY_PLAN_ID}" \
        '{gateway: {ids: {gateway_id: $id, eui: $eui}, name: $name, gateway_server_address: $server, frequency_plan_id: $plan}}' )
    if ! RAW=$( tts_api POST "/api/v3/users/${TTS_USERNAME}/gateways" "${BODY}" ); then
        echo -e "${COLOR_ERROR}ERROR: Autoprovisioning failed, could not reach https://${SERVER}${COLOR_END}\n"
        return
    fi
    if ! jq -e 'type == "object"' > /dev/null 2>&1 <<< "${RAW}"; then
        echo -e "${COLOR_ERROR}ERROR: Autoprovisioning failed, unexpected reply from https://${SERVER}${COLOR_END}\n"
        return
    fi
    CODE=$( jq -r '.code // empty' <<< "${RAW}" )
    MESSAGE=$( jq -r '.message // empty' <<< "${RAW}" )

    # ToDo: find more error codes when provision a gateway via API.
    if [[ -z "$CODE" ]]; then
        echo -e "${COLOR_INFO}Gateway autoprovisioned successfully!${COLOR_END}"
    elif [[ "$CODE" == 6 ]] || [[ "$CODE" == 9 ]]; then
        echo -e "${COLOR_WARNING}WARNING: The gateway was already provisioned.${COLOR_END}"
    else
        echo -e "${COLOR_ERROR}ERROR: Autoprovisioning error $MESSAGE ($CODE).${COLOR_END}\n"
        return
    fi

    # List api keys
    IDS=$( tts_api GET "/api/v3/gateways/${GATEWAY_ID}/api-keys" \
        | jq -r --arg name "${API_KEY_NAME}" '.api_keys[]? | select(.name == $name) | .id' 2>/dev/null )

    # Delete previous API keys
    BODY=$( jq -n --arg name "${API_KEY_NAME}" '{name: $name, rights: [], expires_at: null}' )
    for ID in $IDS; do
        tts_api PUT "/api/v3/gateways/${GATEWAY_ID}/api-keys/${ID}" "${BODY}" > /dev/null
    done

    # Create new api key
    BODY=$( jq -n --arg name "${API_KEY_NAME}" '{name: $name, rights: ["RIGHT_GATEWAY_LINK"], expires_at: null}' )
    RAW=$( tts_api POST "/api/v3/gateways/${GATEWAY_ID}/api-keys" "${BODY}" )
    KEY=$( jq -r '.key // empty' <<< "${RAW}" 2>/dev/null )

    # Only a real key counts: an empty or missing one (or a failed request)
    # leaves TC_KEY unset, and the caller reports the error
    if [[ -n "$KEY" ]]; then
        TC_KEY=$KEY
        echo -e "${COLOR_INFO}TC_KEY successfully generated${COLOR_END}"
    fi

    echo

}

# Prints every PEM block in $1 with its body re-wrapped at 64 columns, which
# repairs values whose line breaks were lost or turned into spaces (as often
# happens with environment variables). Every block is kept, so certificate
# chains stay whole. Content without a PEM block is printed unchanged.
function clean_certs_keys() {

    local CONTENT=$1

    if [[ "$CONTENT" == *-----BEGIN* ]]; then
        printf '%s' "$CONTENT" | perl -0777 -ne '
            my $original = $_;
            my $count = 0;
            while ( /-----BEGIN ([A-Z0-9 ]+)-----(.*?)-----END \1-----/sg ) {
                my ( $label, $body ) = ( $1, $2 );
                $body =~ s/\s+//g;
                $body =~ s/(.{1,64})/$1\n/g;
                print "-----BEGIN $label-----\n$body-----END $label-----\n";
                $count++;
            }
            print "$original\n" if $count == 0;
        '
    else
        echo "$CONTENT"
    fi

}

# -----------------------------------------------------------------------------
# Preparing configuration
# -----------------------------------------------------------------------------

# Move into configuration folder
mkdir -p config
cd config || exit 1
CONFIG_FILE=./station.conf

# -----------------------------------------------------------------------------
# Network device
# -----------------------------------------------------------------------------

[[ "${INTERFACE}" == "NET" ]] && create_network_link

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------

[[ -f "/run/secrets/tc.uri"     ]] &&     TC_URI=$( < /run/secrets/tc.uri     )
[[ -f "/run/secrets/tc.trust"   ]] &&   TC_TRUST=$( < /run/secrets/tc.trust   )
[[ -f "/run/secrets/tc.crt"     ]] &&     TC_CRT=$( < /run/secrets/tc.crt     )
[[ -f "/run/secrets/tc.key"     ]] &&     TC_KEY=$( < /run/secrets/tc.key     )

[[ -f "/run/secrets/cups.uri"   ]] &&   CUPS_URI=$( < /run/secrets/cups.uri   )
[[ -f "/run/secrets/cups.trust" ]] && CUPS_TRUST=$( < /run/secrets/cups.trust )
[[ -f "/run/secrets/cups.crt"   ]] &&   CUPS_CRT=$( < /run/secrets/cups.crt   )
[[ -f "/run/secrets/cups.key"   ]] &&   CUPS_KEY=$( < /run/secrets/cups.key   )

# The autoprovisioning credentials. They end up in an API URL and an HTTP
# header, so line endings are dropped: a file saved with CRLF would otherwise
# leave a CR in both, and the API would reject the request.
[[ -f "/run/secrets/tts.username"     ]] &&     TTS_USERNAME=$( < /run/secrets/tts.username     )
[[ -f "/run/secrets/tts.personal_key" ]] && TTS_PERSONAL_KEY=$( < /run/secrets/tts.personal_key )
TTS_USERNAME=${TTS_USERNAME//[$'\r\n']/}
TTS_PERSONAL_KEY=${TTS_PERSONAL_KEY//[$'\r\n']/}

# -----------------------------------------------------------------------------
# Server configuration
# -----------------------------------------------------------------------------

# Defaults to TTN server v3, `eu1` region,
# use a custom SERVER, CUPS_URI or TC_URI to change this.
# If TTS_TENANT is defined different than "ttn", it will be used to build the
# tenant URL under thethings.industries, otherwise only the region will be used
# to build the URL under cloud.thethings.network.

TTN_REGION=${TTN_REGION:-"eu1"}
TTS_REGION=${TTS_REGION:-$TTN_REGION}
TTS_TENANT=${TTS_TENANT:-"ttn"}
if [[ "$TTS_TENANT" == "ttn" ]]; then
    SERVER=${SERVER:-"${TTS_REGION}.cloud.thethings.network"}
else
    SERVER=${SERVER:-"${TTS_TENANT}.${TTS_REGION}.cloud.thethings.industries"}
fi
CUPS_URI=${CUPS_URI:-"https://${SERVER}:443"}
TC_URI=${TC_URI:-"wss://${SERVER}:8887"}

# -----------------------------------------------------------------------------
# Mode (static/dynamic) & protocol (cups/lns)
# -----------------------------------------------------------------------------

# New USE_CUPS variable, will be mandatory in the future
# Possible values are 0 or 1, setting it here to 2 when undefined
USE_CUPS=${USE_CUPS:-2} # undefined by default
PROTOCOL=""

# TTS credentials only mark the gateway for autoprovisioning here. It runs
# after the gateway EUI is resolved, further down: registering it now would
# send an empty EUI unless GATEWAY_EUI was set by hand.
AUTOPROVISION=0

# Configuration mode
if [[ -f ${CONFIG_FILE} ]]; then
    MODE="STATIC"
    MISSING_CONFIGURATION="ERROR: Custom configuration folder found, but missing files: either force key-less CUPS with USE_CUPS=1 or provide a valid cups.key or tc.key files or TTS_PERSONAL_KEY and TTS_USERNAME (variables or tts.* secrets)"
    if [[ $USE_CUPS -eq 1 ]]; then
        PROTOCOL="CUPS"
    elif [[ -f ./cups.key ]] && [[ $USE_CUPS -ne 0 ]]; then
        PROTOCOL="CUPS"
        echo -e "${COLOR_WARNING}WARNING: USE_CUPS variable will be mandatory in future versions to enable CUPS${COLOR_END}"
    elif [[ -f ./tc.key ]]; then
        PROTOCOL="LNS"
    elif [[ -n "${TTS_PERSONAL_KEY}" ]] && [[ -n "${TTS_USERNAME}" ]]; then
        AUTOPROVISION=1
    fi
else
    MODE="DYNAMIC"
    MISSING_CONFIGURATION="ERROR: Missing configuration, either force key-less CUPS with USE_CUPS=1 or define valid TC_KEY, CUPS_KEY or TTS_PERSONAL_KEY and TTS_USERNAME (variables or tts.* secrets)"
    if [[ $USE_CUPS -eq 1 ]]; then
        PROTOCOL="CUPS"
    elif [[ -n "${CUPS_KEY}" ]] && [[ ${USE_CUPS} -ne 0 ]]; then
        PROTOCOL="CUPS"
        echo -e "${COLOR_WARNING}WARNING: USE_CUPS variable will be mandatory in future versions to enable CUPS${COLOR_END}"
    elif [[ -n "${TC_KEY}" ]]; then
        PROTOCOL="LNS"
    elif [[ -n "${TTS_PERSONAL_KEY}" ]] && [[ -n "${TTS_USERNAME}" ]]; then
        AUTOPROVISION=1
    fi
fi
if [[ -z "${PROTOCOL}" ]] && [[ ${AUTOPROVISION} -eq 0 ]]; then
    echo -e "${COLOR_ERROR}${MISSING_CONFIGURATION}${COLOR_END}"
    idle
fi

# -----------------------------------------------------------------------------
# Retrieve values from static config files
# -----------------------------------------------------------------------------

STATIC_ROUTERID=""
if [[ -f ${CONFIG_FILE} ]]; then

    # Get device & interface. jq prints nothing for a missing key (instead of
    # "null"), and then the usual defaults apply.
    STATIC_DEVICE=$( jq -r '[.. | objects | .device? // empty] | first // empty' "${CONFIG_FILE}" 2>/dev/null )
    if [[ -n "${STATIC_DEVICE}" ]]; then
        DEVICE=${STATIC_DEVICE#spi:}
        DEVICE=${DEVICE#usb:}
        [[ "${DEVICE}" == *"spi"* ]] && INTERFACE="SPI" || INTERFACE="USB"
    fi

    # Guess generic model
    if [[ $( grep -c "SX1302_conf" "${CONFIG_FILE}" ) -ne 0 ]]; then
        MODEL=${MODEL:-"SX1302"}
    elif [[ "${INTERFACE}" == "USB" ]]; then
        MODEL=${MODEL:-"SX1308"}
    else
        MODEL=${MODEL:-"SX1301"}
    fi

    # Get Gateway EUI. Station uses the routerid in the file, so it wins over
    # GATEWAY_EUI. Without one, station picks an EUI of its own.
    STATIC_ROUTERID=$( jq -r '.station_conf.routerid // empty' "${CONFIG_FILE}" 2>/dev/null )
    if [[ -n "${STATIC_ROUTERID}" ]]; then
        GATEWAY_EUI=${STATIC_ROUTERID}
        GATEWAY_EUI_SOURCE="file"
    fi

fi

# -----------------------------------------------------------------------------
# Auto-discover up-front
# -----------------------------------------------------------------------------

# If no MODEL defined we try to find the concentrator
if [[ -z "${MODEL}" ]] || [[ "${MODEL}" == "AUTO" ]]; then

    unset MODEL

    create_reset_file
    discover_concentrator "${INTERFACE:-AUTO}" "${DESIGN:-AUTO}" "${RADIO_NUM:-1}"
    if [[ $? -ne 0 ]]; then

        DESIGN=${RESPONSE[0]}
        DEVICE=${RESPONSE[1]}
        CHIP_ID=${RESPONSE[2]}

        [[ "${DEVICE}" == *"spi"*    ]] && INTERFACE="SPI" || INTERFACE="USB"
        [[ "${DESIGN}" == "corecell" ]] && MODEL="SX1302"
        [[ "${DESIGN}" == "picocell" ]] && MODEL="SX1308"

    else

        echo -e "${COLOR_ERROR}ERROR: MODEL variable not set and we couldn't find any concentrator!${COLOR_END}"
	    idle

    fi

fi

# -----------------------------------------------------------------------------
# Check MODEL
# -----------------------------------------------------------------------------

# MODEL can be:
# * A developing gateway (mostly by RAKwireless), example: RAK7248
# * A concentrator module (by RAKWireless, IMST, SeeedStudio,...), example: RAK5416
# * A concentrator chip (Semtech's naming), example: SX1303
MODEL=${MODEL^^}

# Get the concentrator based on MODEL
declare -A MODEL_MAP=(

    # SX1301
    [SX1301]=SX1301
    [RAK7243]=SX1301 [RAK7243C]=SX1301 [RAK7244]=SX1301 [RAK7244C]=SX1301 [RAK831]=SX1301 [RAK833]=SX1301 [RAK2245]=SX1301 [RAK2247]=SX1301
    [IC880A]=SX1301 [PG1301]=SX1301

    # SX1302
    [SX1302]=SX1302
    [RAK7248]=SX1302 [RAK7248C]=SX1302 [RAK7271]=SX1302 [RAK2287]=SX1302
    [WM1302]=SX1302 [PG1302]=SX1302

    # SX1303
    [SX1303]=SX1303
    [RAK5146]=SX1303 [RAK5166]=SX1303 [RAK5167]=SX1303 [RAK7371]=SX1303

    # SX1308
    [SX1308]=SX1308
    [RAK7246]=SX1308 [RAK7246G]=SX1308 [RAK2246]=SX1308
    [R11E-LR8]=SX1308 [R11E-LR9]=SX1308 [R11E-LORA8]=SX1308 [R11E-LORA9]=SX1308

)

CONCENTRATOR=${MODEL_MAP[$MODEL]}
if [[ -z "${CONCENTRATOR}" ]]; then
    echo -e "${COLOR_ERROR}ERROR: Unknown MODEL value ($MODEL). Valid values are: ${!MODEL_MAP[*]}${COLOR_END}"
	idle
fi

# -----------------------------------------------------------------------------
# Identify interface
# -----------------------------------------------------------------------------

# Backwards compatibility
DEVICE=${DEVICE:-$LORAGW_SPI}

# Models with USB interface
MODELS_WITH_USB="RAK5166 RAK5167 RAK7271 RAK7371 R11E-LORA8 R11E-LORA9 R11E-LR8 R11E-LR9"
if [[ $MODELS_WITH_USB =~ (^|[[:space:]])$MODEL($|[[:space:]]) ]]; then
    INTERFACE="${INTERFACE:-"USB"}"
elif [[ "${DEVICE}" == "AUTO" ]]; then
    INTERFACE=${INTERFACE:-"AUTO"}
else
    INTERFACE=${INTERFACE:-"SPI"}
fi

# -----------------------------------------------------------------------------
# Identify concentrator design
# -----------------------------------------------------------------------------

# Concentrator design
if [[ "${CONCENTRATOR}" == "SX1308" ]] && [[ "${INTERFACE}" == "USB" ]]; then
    DESIGN=${DESIGN:-"picocell"}
elif [[ "${CONCENTRATOR}" == "SX1301" ]] || [[ "${CONCENTRATOR}" == "SX1308" ]]; then
    DESIGN=${DESIGN:-"v2"}
else
    DESIGN=${DESIGN:-"corecell"}
fi
DESIGN=${DESIGN,,}

# -----------------------------------------------------------------------------
# GPIO configuration
# -----------------------------------------------------------------------------

# Backwards compatibility
RESET_GPIO=${RESET_GPIO:-$GW_RESET_GPIO}
POWER_EN_GPIO=${POWER_EN_GPIO:-$GW_POWER_EN_GPIO}

# If interface is USB disable RESET_GPIO, otherwise default to GPIO17 or pin 11
if [[ "${INTERFACE}" == "USB" ]]; then
    RESET_PIN=${RESET_PIN:-0}
else
    RESET_PIN=${RESET_PIN:-11}
fi

# Map hardware pins to GPIO on Raspberry Pi
declare -a GPIO_MAP=( 0 0 0 2 0 3 0 4 14 0 15 17 18 27 0 22 23 0 24 10 0 9 25 11 8 0 7 0 1 5 0 6 12 13 0 19 16 26 20 0 21 )
RESET_GPIO=${RESET_GPIO:-${GPIO_MAP[$RESET_PIN]}}

# The RAK833-SPI/USB has a SPDT to select USB/SPI interfaces
# If used with RAK2247 or RAK2287 hats this is wired to GPIO20
if [[ "$MODEL" == "RAK833" ]]; then
    if [[ "$INTERFACE" != "USB" ]]; then
        POWER_EN_GPIO=${POWER_EN_GPIO:-20}
        POWER_EN_LOGIC=${POWER_EN_LOGIC:-0}
    fi
fi

# Otherwise the default is no power enable pin
POWER_EN_GPIO=${POWER_EN_GPIO:-0}
POWER_EN_LOGIC=${POWER_EN_LOGIC:-1}

# Create reset file
create_reset_file

# -----------------------------------------------------------------------------
# Radio device auto-discovery
# -----------------------------------------------------------------------------

if [[ -z "${DEVICE}" ]] || [[ "${DEVICE}" == "AUTO" ]]; then

    unset DEVICE

    # Look for concentrator
    discover_concentrator "${INTERFACE:-AUTO}" "${DESIGN:-AUTO}" "${RADIO_NUM:-1}"
    if [[ $? -ne 0 ]]; then

        DESIGN=${RESPONSE[0]}
        DEVICE=${RESPONSE[1]}
        CHIP_ID=${RESPONSE[2]}

    else

        echo -e "${COLOR_WARNING}ERROR: DEVICE set to auto discover but no concentrator found! (INTERFACE set to $INTERFACE) ${COLOR_END}"

    fi

fi

# -----------------------------------------------------------------------------
# Radio device defaults
# -----------------------------------------------------------------------------

# If DEVICE not yet defined, use sensible defaults
if [[ -z "${DEVICE}" ]]; then
    if [[ "${INTERFACE}" == "SPI" ]]; then
        DEVICE=${DEVICE:-"/dev/spidev0.0"}
    else
        MODELS_WITHOUT_ACM="RAK833 RAK2247"
        if [[ $MODELS_WITHOUT_ACM =~ (^|[[:space:]])$MODEL($|[[:space:]]) ]]; then
            DEVICE=${DEVICE:-"/dev/ttyUSB0"}
        fi
        DEVICE=${DEVICE:-"/dev/ttyACM0"}
    fi
fi

# Assert device. A render writes the configuration without the radio.
if [[ ! -e $DEVICE ]]; then
    if [[ ${RENDER} -eq 1 ]]; then
        echo -e "${COLOR_WARNING}WARNING: $DEVICE does not exist (ignored by --render)${COLOR_END}"
    else
        echo -e "${COLOR_ERROR}ERROR: $DEVICE does not exist${COLOR_END}"
        idle
    fi
fi

# Fix INTERFACE based on DEVICE
[[ "${DEVICE}" == *"spi"* ]] && INTERFACE="SPI" || INTERFACE="USB"

export LORAGW_SPI=$DEVICE

# -----------------------------------------------------------------------------
# Fix SPI speed based on CONCENTRATOR
# -----------------------------------------------------------------------------

# Set default SPI speed and clock source for SX1301 and SX1308 concentrators to 2MHz and radio_1
if [[ "${CONCENTRATOR}" == "SX1301" ]] || [[ "${CONCENTRATOR}" == "SX1308" ]]; then
    SPI_SPEED=${SPI_SPEED:-2000000}
    CLKSRC=${CLKSRC:-1}
fi

export LORAGW_SPI_SPEED=${SPI_SPEED:-8000000}

# -----------------------------------------------------------------------------
# Gateway EUI
# -----------------------------------------------------------------------------

# Source to get the EUI from (GATEWAY_EUI_NIC is the old name; the new one wins)
GATEWAY_EUI_NIC=${GATEWAY_EUI_NIC:-"manual"}
GATEWAY_EUI_SOURCE=${GATEWAY_EUI_SOURCE:-$GATEWAY_EUI_NIC}

# Check if we should get the GATEWAY_EUI from the chip
if [[ "$GATEWAY_EUI_SOURCE" == "chip" ]]; then

    # Check if it's already cached
    if [[ -n "${CHIP_ID}" ]]; then
        GATEWAY_EUI=${CHIP_ID}
    else
        chip_id "$DESIGN" "$DEVICE"
        if [[ $? -eq 1 ]]; then
            CHIP_ID=${RESPONSE[2]}
            GATEWAY_EUI=${CHIP_ID}
        fi
    fi

fi

# If still no GATEWAY_EUI, build it from a NIC MAC: the one GATEWAY_EUI_SOURCE
# names, else eth0/wlan0/usb0/eth1, else the busiest one
if [[ -z "${GATEWAY_EUI}" ]]; then
    if ! resolve_nic_eui "${GATEWAY_EUI_SOURCE}"; then
        echo -e "${COLOR_ERROR}ERROR: No network interface found. Cannot set gateway EUI.${COLOR_END}"
    fi
fi

# Normalize EUI
GATEWAY_EUI=${GATEWAY_EUI^^}

# Check we have an EUI
if [[ -z ${GATEWAY_EUI} ]] ; then
    echo -e "${COLOR_ERROR}ERROR: GATEWAY_EUI not set.${COLOR_END}"
	idle
fi

# -----------------------------------------------------------------------------
# Autoprovisioning
# -----------------------------------------------------------------------------

SKIP_TC_KEY=0
if [[ ${AUTOPROVISION} -eq 1 ]]; then

    # With a static station.conf, station uses its routerid, or picks an EUI of
    # its own when there is none. Registering any other EUI would leave a
    # gateway that never connects.
    if [[ "${MODE}" == "STATIC" ]] && [[ -z "${STATIC_ROUTERID}" ]]; then
        echo -e "${COLOR_ERROR}ERROR: Autoprovisioning needs the gateway EUI, but station.conf has no routerid. Add \"routerid\" to its station_conf section.${COLOR_END}"
        idle
    fi

    # The registration must use the EUI station uses, so there is no fallback
    TTS_EUI=${GATEWAY_EUI//[:-]/}
    if [[ ! "${TTS_EUI}" =~ ^[0-9A-F]{16}$ ]]; then
        echo -e "${COLOR_ERROR}ERROR: Cannot autoprovision the gateway EUI '${GATEWAY_EUI}': it is not 16 hex digits${COLOR_END}"
        idle
    fi

    if [[ ${RENDER} -eq 1 ]] && [[ ${RENDER_AUTOPROVISION} -eq 0 ]]; then
        echo -e "${COLOR_WARNING}Autoprovisioning skipped (use --autoprovision); tc.key not written, this output is not ready to run${COLOR_END}"
        PROTOCOL="LNS"
        SKIP_TC_KEY=1
    else
        tts_autoprovision
        if [[ -n "${TC_KEY}" ]]; then
            PROTOCOL="LNS"
        else
            echo -e "${COLOR_ERROR}ERROR: Autoprovisioning returned no key${COLOR_END}"
            echo -e "${COLOR_ERROR}${MISSING_CONFIGURATION}${COLOR_END}"
            idle
        fi
    fi

fi

# -----------------------------------------------------------------------------
# GPS Configuration
# -----------------------------------------------------------------------------

# Models with I2C GPS
MODELS_WITH_I2C_GPS="RAK7243C RAK7244C RAK7248C"
if [[ $MODELS_WITH_I2C_GPS =~ (^|[[:space:]])$MODEL($|[[:space:]]) ]]; then
    GPS_DEV=${GPS_DEV:-"/dev/i2c-1"}
fi

# Models with UART GPS
MODELS_WITH_UART_GPS="RAK7243 RAK7244 RAK7246G RAK7248 RAK831 RAK2245 RAK2287 RAK5146"
if [[ $MODELS_WITH_UART_GPS =~ (^|[[:space:]])$MODEL($|[[:space:]]) ]]; then
    GPS_DEV=${GPS_DEV:-"/dev/ttyAMA0"}
fi

# Is GPS interface set?
if [[ -z "$GPS_DEV" ]] || [[ ! -e $GPS_DEV ]]; then
    HAS_GPS=0
else
    HAS_GPS=${HAS_GPS:-1}
fi
[[ $HAS_GPS -eq 0 ]] && GPS_DEV="" # allows to disable GPS in models with GPS

# -----------------------------------------------------------------------------
# Whitelists
# -----------------------------------------------------------------------------

# whitelist_entries NAME: checks the comma or space separated list in the
# variable NAME and sets WHITELIST_ENTRIES to its values as 0x%06X. Station
# keeps at most 16 per list. Values are decimal or 0x hex; a decimal with a
# leading zero is rejected because it used to be read as octal, so 000013
# silently became 0x00000B.
function whitelist_entries {

    local NAME=$1
    local ENTRY VALUE HINT
    local -a ENTRIES=() VALUES=()

    IFS=', ' read -r -a ENTRIES <<< "${!NAME}"
    for ENTRY in "${ENTRIES[@]}"; do
        [[ -z "${ENTRY}" ]] && continue
        HINT=""
        if [[ "${ENTRY}" =~ ^0[xX][0-9A-Fa-f]{1,6}$ ]]; then
            VALUE=$(( 16#${ENTRY:2} ))
        elif [[ "${ENTRY}" =~ ^(0|[1-9][0-9]{0,7})$ ]] && (( 10#${ENTRY} <= 0xFFFFFF )); then
            VALUE=$(( 10#${ENTRY} ))
        else
            [[ "${ENTRY}" =~ ^0[0-9]+$ ]] && HINT=" (use 0x${ENTRY} for hex)"
            echo -e "${COLOR_ERROR}ERROR: ${NAME} entry '${ENTRY}' is not a valid 3-byte number${HINT}${COLOR_END}"
            return 1
        fi
        VALUES+=( "$( printf '0x%06X' "${VALUE}" )" )
    done

    if [[ ${#VALUES[@]} -gt 16 ]]; then
        echo -e "${COLOR_ERROR}ERROR: ${NAME} has ${#VALUES[@]} entries, the limit is 16${COLOR_END}"
        return 1
    fi

    WHITELIST_ENTRIES="${VALUES[*]}"

}

# A static station.conf brings its own lists, and these variables are ignored
# (the summary says so), so they are only checked when they are used
if [[ "${MODE}" == "DYNAMIC" ]]; then
    whitelist_entries WHITELIST_NETIDS || idle
    WHITELIST_NETIDS=${WHITELIST_ENTRIES}
    whitelist_entries WHITELIST_OUIS || idle
    WHITELIST_OUIS=${WHITELIST_ENTRIES}
else
    WHITELIST_NETIDS=$( jq -r '(.station_conf.whitelist_netids // []) | map(tostring) | join(" ")' "${CONFIG_FILE}" 2>/dev/null )
    WHITELIST_OUIS=$( jq -r '(.station_conf.whitelist_ouis // []) | map(tostring) | join(" ")' "${CONFIG_FILE}" 2>/dev/null )
    STATIC_GPS=$( jq -r '.station_conf.gps // empty' "${CONFIG_FILE}" 2>/dev/null )
fi

